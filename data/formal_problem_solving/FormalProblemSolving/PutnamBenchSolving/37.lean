import FormalProblemSolving.Basic
open Polynomial Real Complex

/-
## Problem
Let $H$ be a subgroup of the additive group of ordered pairs of integers under componentwise addition. If $H$ is generated by the elements $(3, 8)$, $(4, -1)$, and $(5, 4)$, then $H$ is also generated by two elements $(1, b)$ and $(0, a)$ for some integer $b$ and positive integer $a$. Find $a$.

## Answer
7
-/

-- # Formal Answer
noncomputable abbrev Q37.gt := fun (answer : ℤ) => answer = (7 : ℤ)

-- # Formal Problem (FPS)
namespace PutnamBenchSolving_FPS
open scoped FPS

problem Q37
find (answer : ℤ) s.t.
  (H : Set (ℤ × ℤ))
  (hH : H = {h : (ℤ × ℤ) | ∃ u v w : ℤ, h = (u*3 + v*4 + w*5, u*8 + v*(-1) + w*4)})
: ((∃ b : ℤ, H = {h : (ℤ × ℤ) | ∃ u v : ℤ, h = (u, u*b + v*answer)}) ∧ answer > 0)
:= solve
-- Placeholder
all_goals sorry

end PutnamBenchSolving_FPS

-- # Formal Problem (D-FPS)
namespace PutnamBenchSolving_DFPS
open scoped DFPS

problem Q37
find_all (answer : ℤ) iff
  (H : Set (ℤ × ℤ))
  (hH : H = {h : (ℤ × ℤ) | ∃ u v w : ℤ, h = (u*3 + v*4 + w*5, u*8 + v*(-1) + w*4)})
: ((∃ b : ℤ, H = {h : (ℤ × ℤ) | ∃ u v : ℤ, h = (u, u*b + v*answer)}) ∧ answer > 0)
:= solve
case Answer := sorry
all_goals sorry

end PutnamBenchSolving_DFPS
